# Railway will usually provide PORT automatically
HOST=::
PORT=8080

# Admin dashboard Basic Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Morneven backend connection
MORNEVEN_BACKEND_INTERNAL_URL=http://${{morneven-backend.RAILWAY_PRIVATE_DOMAIN}}:8080
MORNEVEN_BACKEND_PUBLIC_URL=https://api.morneven.example
MORNEVEN_BOT_MANAGER_SYNC_TOKEN=replace-with-backend-sync-token
NANOBOT_MORNEVEN_RELOAD_TOKEN=replace-with-nanobot-reload-token

# Optional: persistent workspace path (Dockerfile already sets this)
NANOBOT_AGENTS__DEFAULTS__WORKSPACE=/data/.nanobot/workspace
